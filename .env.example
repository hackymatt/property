# General
ENV=local

# Django
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Django superuser (created on first startup)
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me

# Database (docker-compose service name: db)
DATABASE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=property
DB_USER=postgres
DB_PASSWORD=change-me

# RabbitMQ (docker-compose service name: rabbitmq)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

RABBITMQ_JOB_QUEUE=scraper_jobs
RABBITMQ_JOB_EXCHANGE=job_exchange
RABBITMQ_DATA_QUEUE=data_ingestion_jobs
RABBITMQ_DATA_EXCHANGE=data_exchange
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=job.*.*.pending
RABBITMQ_DATA_ROUTING_KEY=data.*.*.pending
RABBITMQ_THROTTLE_QUEUE=throttle_requests
RABBITMQ_SCHEDULE_QUEUE=schedule
RABBITMQ_SCHEDULE_EXCHANGE=schedule_exchange

# Redis (docker-compose service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Throttling defaults (overridden per-domain via Django admin)
CONFIG_REFRESH_INTERVAL=60
DEFAULT_REQUESTS_PER_SECOND=1.0
DEFAULT_BURST_CAPACITY=2
DEFAULT_CONCURRENT_REQUESTS=1
DEFAULT_TIMEOUT=30

# Service startup
STARTUP_RETRIES=5
STARTUP_RETRY_DELAY=5
